# 复制为 .env 并仅保存在本机；后端不会把密钥返回给客户端。
# 更推荐：启动后在 Web「设置」页选择 Provider 并粘贴官方 Key，一键保存到
# data/runtime-provider.json（0600 权限），无需改本文件或重启服务。
# 可用的 Provider：local_rule / openai_compatible / deepseek / anthropic / opencode。
OPENAI_API_KEY=
OPENAI_BASE_URL=
# auto：未配置 API Key 时使用零配置本地规则引擎；
# 配置 Key 后默认使用 OpenAI。也可显式填写 provider 名。
KNOWLEDGEDEBT_AI_PROVIDER=auto
KNOWLEDGEDEBT_EMBEDDING_PROVIDER=hash
# 留空时按所选 Provider 自动选择默认模型。
KNOWLEDGEDEBT_AI_MODEL=
KNOWLEDGEDEBT_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGEDEBT_DATA_DIR=./data

# 语音转写默认使用本地 faster-whisper，中英文自动检测，音频不会外传。
KNOWLEDGEDEBT_ASR_PROVIDER=auto
KNOWLEDGEDEBT_LOCAL_ASR=1
# 模型可选：tiny / base / small / medium；small 兼顾准确率与 CPU 开销。
KNOWLEDGEDEBT_LOCAL_ASR_MODEL=small
KNOWLEDGEDEBT_LOCAL_ASR_DEVICE=auto
KNOWLEDGEDEBT_LOCAL_ASR_COMPUTE_TYPE=auto
# 留空表示自动检测语言；也可固定为 zh 或 en。
KNOWLEDGEDEBT_LOCAL_ASR_LANGUAGE=
# 仅当 KNOWLEDGEDEBT_ASR_PROVIDER=openai_compatible 时使用。
KNOWLEDGEDEBT_ASR_MODEL=gpt-4o-mini-transcribe

# 留空时使用零配置 SQLite。生产环境示例：
# postgresql://knowledgedebt:change-me@database:5432/knowledgedebt
KNOWLEDGEDEBT_DATABASE_URL=

# 默认使用本地存储；AWS S3、R2 或 MinIO 等兼容服务请设置为 s3。
KNOWLEDGEDEBT_STORAGE_PROVIDER=local
KNOWLEDGEDEBT_S3_BUCKET=
KNOWLEDGEDEBT_S3_ENDPOINT_URL=

# API 可被本机以外访问时，建议设置单用户访问令牌。
KNOWLEDGEDEBT_ACCESS_TOKEN=

# compose.yaml 使用该密码创建 PostgreSQL 服务并连接后端；部署前必须修改。
POSTGRES_PASSWORD=change-this-password

# Next.js 同源 API 代理在服务端访问的后端地址。
KNOWLEDGEDEBT_API_URL=http://127.0.0.1:8123
