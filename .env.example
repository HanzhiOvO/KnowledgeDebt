# 复制为 .env 并仅保存在本机；后端不会把密钥返回给客户端。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KNOWLEDGEDEBT_AI_PROVIDER=openai_compatible
KNOWLEDGEDEBT_ASR_PROVIDER=openai_compatible
KNOWLEDGEDEBT_EMBEDDING_PROVIDER=hash
KNOWLEDGEDEBT_AI_MODEL=gpt-5-mini
KNOWLEDGEDEBT_ASR_MODEL=gpt-4o-mini-transcribe
KNOWLEDGEDEBT_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGEDEBT_DATA_DIR=./data

# 留空时使用零配置 SQLite。生产环境示例：
# postgresql://knowledgedebt:change-me@database:5432/knowledgedebt
KNOWLEDGEDEBT_DATABASE_URL=

# 默认使用本地存储；AWS S3、R2 或 MinIO 等兼容服务请设置为 s3。
KNOWLEDGEDEBT_STORAGE_PROVIDER=local
KNOWLEDGEDEBT_S3_BUCKET=
KNOWLEDGEDEBT_S3_ENDPOINT_URL=

# API 可被本机以外访问时，建议设置单用户访问令牌。
KNOWLEDGEDEBT_ACCESS_TOKEN=

# compose.yaml 使用该密码创建 PostgreSQL 服务并连接后端；部署前必须修改。
POSTGRES_PASSWORD=change-this-password

# Next.js 同源 API 代理在服务端访问的后端地址。
KNOWLEDGEDEBT_API_URL=http://127.0.0.1:8123
