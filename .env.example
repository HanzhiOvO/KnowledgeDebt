# Copy to .env and keep it local. The backend never exposes the key to clients.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KNOWLEDGEDEBT_AI_PROVIDER=openai_compatible
KNOWLEDGEDEBT_ASR_PROVIDER=openai_compatible
KNOWLEDGEDEBT_EMBEDDING_PROVIDER=openai_compatible
KNOWLEDGEDEBT_AI_MODEL=gpt-5-mini
KNOWLEDGEDEBT_ASR_MODEL=gpt-4o-mini-transcribe
KNOWLEDGEDEBT_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGEDEBT_DATA_DIR=./data

# Local is the zero-configuration default. Use s3 for AWS S3, R2, or MinIO.
KNOWLEDGEDEBT_STORAGE_PROVIDER=local
KNOWLEDGEDEBT_S3_BUCKET=
KNOWLEDGEDEBT_S3_ENDPOINT_URL=

# Optional single-user protection when the API is reachable beyond localhost.
KNOWLEDGEDEBT_ACCESS_TOKEN=
