# 复制为 .env 并只保存在本机。默认配置不会调用任何付费 API。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KNOWLEDGEDEBT_AI_PROVIDER=openai_compatible
KNOWLEDGEDEBT_ASR_PROVIDER=openai_compatible
KNOWLEDGEDEBT_EMBEDDING_PROVIDER=hash
KNOWLEDGEDEBT_AI_MODEL=gpt-5-mini
KNOWLEDGEDEBT_ASR_MODEL=gpt-4o-mini-transcribe
KNOWLEDGEDEBT_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGEDEBT_DATA_DIR=./data

# 保存 Provider 密钥时必须配置有效的 Fernet 主密钥；否则只允许 env:VARIABLE 引用。
# 生成方式见 docs/providers.md。切勿提交真实值。
KNOWLEDGEDEBT_ENCRYPTION_KEY=

# 录音先保存，再自动转写。外部 ASR 仍会逐次要求明确授权，授权前不创建 Job。
KNOWLEDGEDEBT_AUTO_TRANSCRIBE=true
KNOWLEDGEDEBT_FFMPEG_PATH=ffmpeg
KNOWLEDGEDEBT_TRANSCRIPTION_CHUNK_SECONDS=1500

# 本地转写（whisper.cpp 命令行）。留空模型即视为未就绪，不会启用本地默认路由。
# 安装、选型与故障排查见 docs/local-asr.md；模型文件不要提交到仓库。
KNOWLEDGEDEBT_LOCAL_ASR_BINARY=whisper-cli
KNOWLEDGEDEBT_LOCAL_ASR_MODEL=
KNOWLEDGEDEBT_LOCAL_ASR_MODEL_DIR=
KNOWLEDGEDEBT_LOCAL_ASR_LANGUAGE=zh
KNOWLEDGEDEBT_LOCAL_ASR_THREADS=0
KNOWLEDGEDEBT_LOCAL_ASR_TIMEOUT_SECONDS=3600
KNOWLEDGEDEBT_LOCAL_ASR_INITIAL_PROMPT=

# 私网 ASR 服务（另一台机器）。Base URL 必须是私网地址，公网地址会被后端拒绝。
KNOWLEDGEDEBT_LOCAL_ASR_SERVICE_URL=
KNOWLEDGEDEBT_LOCAL_ASR_SERVICE_MODEL=
# whisper.cpp 自带 server 没有 OpenAI 路由，需要改成 /inference（实测结论见 docs/local-asr.md）。
KNOWLEDGEDEBT_LOCAL_ASR_SERVICE_PATH=/audio/transcriptions
KNOWLEDGEDEBT_LOCAL_ASR_SERVICE_CONVERT_WAV=false

# 教务同步默认 6 小时。当前浙江工商大学连接器仅支持脱敏 fixture 导入。
KNOWLEDGEDEBT_SCHEDULE_SYNC_INTERVAL_MINUTES=360

# 留空时使用零配置 SQLite。生产环境示例：
# postgresql://knowledgedebt:change-me@database:5432/knowledgedebt
KNOWLEDGEDEBT_DATABASE_URL=

# 默认使用本地存储；AWS S3、R2 或 MinIO 等兼容服务请设置为 s3。
KNOWLEDGEDEBT_STORAGE_PROVIDER=local
KNOWLEDGEDEBT_S3_BUCKET=
KNOWLEDGEDEBT_S3_ENDPOINT_URL=

# API 可被本机以外访问时，建议设置单用户访问令牌。
KNOWLEDGEDEBT_ACCESS_TOKEN=

# compose.yaml 使用该密码创建 PostgreSQL 服务并连接后端；部署前必须修改。
POSTGRES_PASSWORD=change-this-password

# Next.js 同源 API 代理在服务端访问的后端地址。
KNOWLEDGEDEBT_API_URL=http://127.0.0.1:8123
